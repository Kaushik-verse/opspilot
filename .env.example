# Copy to .env and fill in. Only FREE tiers are needed.

# Groq free tier: https://console.groq.com/keys
GROQ_API_KEY=

# Provider for both tiers: groq | ollama | openai_compatible
OPSPILOT_PROVIDER=groq

# Cascade models (run `opspilot models` to list what your key can access)
OPSPILOT_SMALL_MODEL=openai/gpt-oss-20b
OPSPILOT_LARGE_MODEL=openai/gpt-oss-120b

# Reasoning effort for gpt-oss models (low keeps free-tier token use down)
OPSPILOT_REASONING_EFFORT=low

# Optional: put the large tier on a different free provider (any OpenAI-compatible API)
# OPSPILOT_LARGE_PROVIDER=openai_compatible
# OPSPILOT_LARGE_BASE_URL=https://example.com/v1
# OPSPILOT_LARGE_API_KEY=
